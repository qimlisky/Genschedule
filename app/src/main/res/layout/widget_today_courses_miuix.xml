<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_today_background">

    <ImageView
        android:id="@+id/widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_today_background"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="gone"
        tools:targetApi="s" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="true"
                android:maxLines="1"
                android:textColor="#FF111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:includeFontPadding="true"
                android:maxLines="1"
                android:textColor="#99000000"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="true"
                android:maxLines="1"
                android:textColor="#99000000"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/widget_app_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher_kanban" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#99000000"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_large_courses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/widget_course_row_1"
                style="@style/WidgetCourseRowFrame">
                <ImageView
                    android:id="@+id/widget_course_background_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/widget_course_content_1"
                    style="@style/WidgetCourseRowContent">
                    <LinearLayout style="@style/WidgetCourseTimeColumn">
                        <TextView android:id="@+id/widget_course_time_1" style="@style/WidgetCourseTimePrimary" />
                        <TextView android:id="@+id/widget_course_end_1" style="@style/WidgetCourseTimeSecondary" />
                    </LinearLayout>
                    <ImageView android:id="@+id/widget_course_indicator_1" style="@style/WidgetCourseIndicator" android:contentDescription="@null" />
                    <LinearLayout style="@style/WidgetCourseInfoColumn">
                        <TextView android:id="@+id/widget_course_name_1" style="@style/WidgetCourseName" />
                        <TextView android:id="@+id/widget_course_detail_1" style="@style/WidgetCourseDetail" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_course_row_2"
                style="@style/WidgetCourseRowFrame"
                android:layout_marginTop="4dp">
                <ImageView
                    android:id="@+id/widget_course_background_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/widget_course_content_2"
                    style="@style/WidgetCourseRowContent">
                    <LinearLayout style="@style/WidgetCourseTimeColumn">
                        <TextView android:id="@+id/widget_course_time_2" style="@style/WidgetCourseTimePrimary" />
                        <TextView android:id="@+id/widget_course_end_2" style="@style/WidgetCourseTimeSecondary" />
                    </LinearLayout>
                    <ImageView android:id="@+id/widget_course_indicator_2" style="@style/WidgetCourseIndicator" android:contentDescription="@null" />
                    <LinearLayout style="@style/WidgetCourseInfoColumn">
                        <TextView android:id="@+id/widget_course_name_2" style="@style/WidgetCourseName" />
                        <TextView android:id="@+id/widget_course_detail_2" style="@style/WidgetCourseDetail" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_course_row_3"
                style="@style/WidgetCourseRowFrame"
                android:layout_marginTop="4dp">
                <ImageView
                    android:id="@+id/widget_course_background_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/widget_course_content_3"
                    style="@style/WidgetCourseRowContent">
                    <LinearLayout style="@style/WidgetCourseTimeColumn">
                        <TextView android:id="@+id/widget_course_time_3" style="@style/WidgetCourseTimePrimary" />
                        <TextView android:id="@+id/widget_course_end_3" style="@style/WidgetCourseTimeSecondary" />
                    </LinearLayout>
                    <ImageView android:id="@+id/widget_course_indicator_3" style="@style/WidgetCourseIndicator" android:contentDescription="@null" />
                    <LinearLayout style="@style/WidgetCourseInfoColumn">
                        <TextView android:id="@+id/widget_course_name_3" style="@style/WidgetCourseName" />
                        <TextView android:id="@+id/widget_course_detail_3" style="@style/WidgetCourseDetail" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_course_row_4"
                style="@style/WidgetCourseRowFrame"
                android:layout_marginTop="4dp">
                <ImageView
                    android:id="@+id/widget_course_background_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/widget_course_content_4"
                    style="@style/WidgetCourseRowContent">
                    <LinearLayout style="@style/WidgetCourseTimeColumn">
                        <TextView android:id="@+id/widget_course_time_4" style="@style/WidgetCourseTimePrimary" />
                        <TextView android:id="@+id/widget_course_end_4" style="@style/WidgetCourseTimeSecondary" />
                    </LinearLayout>
                    <ImageView android:id="@+id/widget_course_indicator_4" style="@style/WidgetCourseIndicator" android:contentDescription="@null" />
                    <LinearLayout style="@style/WidgetCourseInfoColumn">
                        <TextView android:id="@+id/widget_course_name_4" style="@style/WidgetCourseName" />
                        <TextView android:id="@+id/widget_course_detail_4" style="@style/WidgetCourseDetail" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
